# InferPath Research Prototype - Environment Configuration Example
# Copy this file to .env and populate with your credentials.
# NEVER commit .env to version control.

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Base URL (Default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Application Environment (research, development, production)
INFERPATH_ENV=research

# SQLite Database Path
INFERPATH_DB_PATH=data/storage/inferpath.db

# Model Selection Defaults
INFERPATH_SMALL_MODEL=google/gemini-2.5-flash
INFERPATH_LARGE_MODEL=anthropic/claude-3.7-sonnet

# Telemetry and Execution Controls
INFERPATH_STRICT_PRIVACY=true
INFERPATH_ENABLE_CACHE=true
INFERPATH_ENABLE_FALLBACK=true
INFERPATH_LOG_LEVEL=INFO
