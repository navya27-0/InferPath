# =============================================================================
# InferPath Research Prototype - Environment Configuration Reference
# =============================================================================
# Copy this file to .env and populate with your credentials.
# NEVER commit .env to version control.
#
# QUICKSTART MODES:
# 1. Local Offline Demo:
#    Use docker-compose.local-demo.yml (requires NO api keys, runs simulated models on 127.0.0.1):
#      docker compose -f docker-compose.local-demo.yml up
#
# 2. Production Deployment:
#    Configure INFERPATH_DEPLOYMENT_MODE=production, INFERPATH_API_KEY, and OPENROUTER_API_KEY:
#      docker compose up
# =============================================================================

# --- Deployment & Security Profiles ---
# Options: local-demo, evaluation, staging, production
# - local-demo: Allows unauthenticated access on loopback (127.0.0.1) using simulated models.
# - production: Strictly requires INFERPATH_API_KEY and real provider credentials; fails closed.
INFERPATH_DEPLOYMENT_MODE=production
INFERPATH_ENVIRONMENT=production

# Network Interface Bindings
# Defaults strictly to loopback (127.0.0.1) for defense-in-depth against public exposure.
# Setting to 0.0.0.0 is strictly prohibited unless an authenticated profile and API key are configured.
INFERPATH_HOST_BIND=127.0.0.1
INFERPATH_DASHBOARD_BIND=127.0.0.1

# Application Authentication Key
# Required when running under 'production' or 'staging' profiles or binding to non-loopback.
# Clients must provide this in the X-API-Key or Authorization: Bearer header.
INFERPATH_API_KEY=your_secure_random_api_key_here

# --- Live Model Provider Credentials ---
# Required for real inference execution under production / staging profiles.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Adapter Execution Mode: simulated | real
ADAPTER_MODE=simulated

# --- Storage & Distributed Caching ---
# SQLite Local Cache Path
INFERPATH_DB_PATH=data/storage/inferpath.db

# Optional Redis Distributed Rate Limiter & Cache URL
# Example: redis://:redis_password@redis:6379/0
# INFERPATH_REDIS_URL=redis://localhost:6379/0
# INFERPATH_RATE_LIMIT_FAIL_CLOSED=true

# --- Model Selection Defaults ---
INFERPATH_SMALL_MODEL=google/gemini-2.5-flash
INFERPATH_LARGE_MODEL=anthropic/claude-3.7-sonnet

# --- Telemetry & Operational Controls ---
INFERPATH_STRICT_PRIVACY=true
INFERPATH_ENABLE_CACHE=true
INFERPATH_ENABLE_FALLBACK=true
INFERPATH_LOG_LEVEL=INFO
